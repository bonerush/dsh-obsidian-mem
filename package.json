{
  "name": "dsh-obsidian-mem",
  "version": "0.1.0",
  "description": "DeepSeek Harness host plugin that keeps project documents and long-term memory as plain Markdown in a dedicated Obsidian vault.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "obsidian",
    "project-memory",
    "agent-memory",
    "markdown",
    "fts5"
  ],
  "homepage": "https://github.com/bonerush/dsh-obsidian-mem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonerush/dsh-obsidian-mem.git"
  },
  "bugs": {
    "url": "https://github.com/bonerush/dsh-obsidian-mem/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2",
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "files": [
    "lib",
    "skills/obsidian-mem/SKILL.md",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "prepack": "npm test && node scripts/verify-pack.mjs"
  }
}
