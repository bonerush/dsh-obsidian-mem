{
  "name": "dsh-obsidian-mem",
  "version": "0.1.10",
  "description": "DeepSeek Harness host plugin that keeps project documents and long-term memory as plain Markdown in a dedicated Obsidian vault.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "obsidian",
    "project-memory",
    "agent-memory",
    "markdown",
    "fts5"
  ],
  "homepage": "https://github.com/bonerush/dsh-obsidian-mem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonerush/dsh-obsidian-mem.git"
  },
  "bugs": {
    "url": "https://github.com/bonerush/dsh-obsidian-mem/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-obsidian-mem-diagnose": "./lib/diagnose-cli.js",
    "dsh-obsidian-mem-review": "./lib/curation-cli.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2",
    "dsh": ">=0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1",
    "dsh-better-sidebar": ">=0.21.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "d3-force": "3.0.0",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "semver": "7.8.5",
    "typescript": "5.9.3"
  },
  "files": [
    "lib",
    "skills/obsidian-mem/SKILL.md",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "pack:check": "node scripts/verify-tarball.mjs",
    "check:fast": "node scripts/check-staged.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check": "npm run lint && npm run format:check && npm run types && npm run prepack && npm run pack:check",
    "format": "prettier --write \"lib/**/*.js\" \"test/**/*.js\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"codex/**/*.mjs\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"lib/**/*.js\" \"test/**/*.js\" \"test/**/*.mjs\" \"scripts/**/*.mjs\" \"codex/**/*.mjs\" \"eslint.config.mjs\"",
    "prepack": "npm test && node scripts/verify-pack.mjs"
  }
}
